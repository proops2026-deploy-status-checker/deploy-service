{
  "name": "deploy-service",
  "version": "0.1.0",
  "private": true,
  "description": "Deploy Status Checker - Deploy Service",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "lint": "eslint .",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:coverage": "npm run build && c8 --reporter=lcov --reporter=text node --test test/*.test.cjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "express": "^5.1.0",
    "redis": "^6.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "c8": "^10.1.3",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prisma": "^6.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0"
  }
}
